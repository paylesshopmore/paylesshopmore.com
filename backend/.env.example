# Copy to .env and fill in. .env is never committed. Only the payment-related
# variables are listed here; see config/settings.py for the rest.

# Stripe: https://dashboard.stripe.com/test/apikeys (use TEST keys first).
STRIPE_SECRET_KEY=sk_test_replace_me
# From `stripe listen --forward-to localhost:8000/api/payments/webhook/`
# locally, or from the webhook endpoint's page in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Where the React site lives. Stripe sends customers back here after paying.
DJANGO_FRONTEND_URL=http://localhost:5173
